# Installed as /etc/java-tron-security-review/jtsr.env.
# Keep this file mode 0600. Do not commit a populated copy.

JTSR_IMAGE=java-tron-security-review:local
JTSR_PROVIDER=openai
# Use "chatgpt" for a persisted ChatGPT device sign-in, or "api-key" for
# OPENAI_API_KEY/CODEX_API_KEY authentication.
JTSR_AUTH=chatgpt
JTSR_TARGET_REPOSITORY_URL=https://github.com/tronprotocol/java-tron.git
JTSR_TARGET_REF=develop
JTSR_OUTPUT_ROOT=/var/lib/java-tron-security-review/scans
JTSR_WORK_ROOT=/var/lib/java-tron-security-review/work
# ChatGPT refresh credentials are stored here, separately from scan evidence.
JTSR_AUTH_ROOT=/var/lib/java-tron-security-review/auth
JTSR_RETENTION_DAYS=90
JTSR_MEMORY_LIMIT=8g
JTSR_CPU_LIMIT=4
JTSR_PIDS_LIMIT=512
JTSR_DOCKER_NETWORK=bridge
JTSR_SCANNER_UID=10001
JTSR_SCANNER_GID=10001

# Required only when JTSR_AUTH=api-key. CODEX_API_KEY is also accepted.
OPENAI_API_KEY=

# Optional: force both passes to one model. Leave empty to use the two configured
# profiles (gpt-5.6-terra triage and gpt-5.6-sol verifier).
JTSR_MODEL=

# Optional failure-only webhook. The payload contains operational status only,
# never findings or source excerpts.
JTSR_FAILURE_WEBHOOK_URL=

# Bedrock-only settings. Prefer an EC2 instance profile over long-lived keys.
AWS_REGION=us-east-2
